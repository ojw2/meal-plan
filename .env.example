# Copy to .env and fill in. Used by docker compose and local dev.

# Postgres (compose creates the database with these)
POSTGRES_USER=mealplan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mealplan

# Local dev / tests connect to the dev DB container on port 54329
# (docker compose -f compose.yaml -f compose.dev.yaml up -d db)
DATABASE_URL=postgres://mealplan:change-me@localhost:54329/mealplan

# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=

# Spoonacular (Milestone 3). Leave SPOONACULAR_LIVE unset to use fixtures.
SPOONACULAR_API_KEY=
# SPOONACULAR_LIVE=1

# Set to false only if serving over plain HTTP (not recommended; Tailscale gives HTTPS)
# COOKIE_SECURE=false

# Server timezone (household timezone itself is set in the app)
TZ=America/New_York

# Where the app listens on the host; tailscale serve proxies to this.
APP_BIND=127.0.0.1
APP_PORT=3000

# Nightly pg_dump destination on the host (e.g. a NAS mount)
BACKUP_DIR=./backups
